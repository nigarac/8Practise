<UserControl x:Class="Shop_Сизов.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Shop_Сизов.Elements"
             mc:Ignorable="d">
    <Grid>
        <Border
            Margin="20"
            Width="250"
            CornerRadius="20"
            Background="#FF5A5A5A">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Image
                    
                    Margin="20"
                    Width="160"
                    Source="/Images/ic_item.png"/>
                <Label
                    x:Name="lName"
                    Content="Наименование"
                    Margin="10"
                    Grid.Row="1"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Top"
                    FontWeight="Bold"
                    Foreground="White"/>
                <Label
                    x:Name="lPrice"
                    Content="Стоимость"
                    Margin="10,40"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    Foreground="White"/>
                <Label
                    x:Name="lCharacketeristic"
                    Content="Характеристика"
                    Margin="10,70,10,10"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    Foreground="White"/>
                <Label
                    x:Name="lSpeed"
                    Content="Скорость"
                    Margin="10,96,10,0"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    Foreground="White"
                    Visibility="Hidden"/>

            </Grid>
            <Border.Effect>
                <DropShadowEffect BlurRadius="3"/>
            </Border.Effect>
        </Border>

    </Grid>
</UserControl>
